# Copy to backend/.env and fill in your own values. Never commit .env.

# --- Main pipeline model (Triage / Readiness / Automation Intent / Intent / Planning) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Review panel (Goal-Match + Feasibility) — deliberately a different model/provider ---
REVIEW_AGENT_API_KEY=
REVIEW_AGENT_BASE_URL=
REVIEW_AGENT_MODEL=

# --- Execution providers ---
ENSO_API_KEY=
RELAY_API_KEY=
OKX_ONCHAIN_API_KEY=
OKX_ONCHAIN_SECRET_KEY=
OKX_ONCHAIN_PASSPHRASE=
# Which same-chain swap provider is tried first: "enso" (default) or "okx"
SAME_CHAIN_SWAP_PRIMARY=

# --- Data providers ---
ALCHEMY_API_KEY=
ALCHEMY_API_KEY_2=
ALCHEMY_API_KEY_3=
CMC_API_KEY=
ETHERSCAN_API_KEY=

# --- Auth ---
SESSION_JWT_SECRET=
GOOGLE_CLIENT_ID=

# --- Privy execution wallets ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWKS_URL=
PRIVY_AUTHORIZATION_PRIVATE_KEY_B64=
PRIVY_AUTHORIZATION_PUBLIC_KEY_DER_B64=
PRIVY_AUTHORIZATION_KEY_QUORUM_ID=

# --- Optional / dev only ---
# Funding-only key for test setups. Never the signer under test.
EXECUTOR_PRIVATE_KEY=
ZERODEV_PROJECT_ID=
